<?xml version="1.0" encoding="UTF-8"?>

<!ELEMENT mozi (film)*>

<!ELEMENT film (rendezo+, szinesz+, iro+)>
<!ELEMENT rendezo (nev+, telefonszam+)>
<!ELEMENT szinesz (gyerekszinesz*, musicalszinesz*, szinkronszinesz*)>
<!ELEMENT iro (nev, datum)>

<!ELEMENT nev (#PCDATA)>
<!ELEMENT telefonszam (#PCDATA)>
<!ELEMENT datum (#PCDATA)>

<!ELEMENT gyerekszinesz EMPTY>
<!ELEMENT musicalszinesz EMPTY>
<!ELEMENT szinkronszinesz EMPTY>

<!ATTLIST film
    id ID #REQUIRED
    mufaj (horror | romantikus | thriller) "horror"
>

<!ATTLIST szinesz
    id ID #REQUIRED
    nev CDATA #IMPLIED
>
