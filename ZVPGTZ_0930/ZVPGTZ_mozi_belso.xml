        </rendezo>
        <szinesz id="j" nev="Martin"></szinesz>
        <szinesz id="q">
            <gyerekszinesz />
            <musicalszinesz />
            <szinkronszinesz />
        </szinesz>
        <iro>
            <nev>J. R. R. Tolkien</nev>
            <datum>29 July 1954</datum>
        </iro>
    </film>
</mozi>