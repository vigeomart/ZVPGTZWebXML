<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="hallgato">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="student" type="studentTipus" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="studentTipus">
        <xs:sequence>
            <xs:element name="keresztnev" type="xs:string"></xs:element>
            <xs:element name="vezeteknev" type="xs:string"></xs:element>
            <xs:element name="foglalkozas" type="xs:string"></xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string"></xs:attribute>
    </xs:complexType>
</xs:schema>