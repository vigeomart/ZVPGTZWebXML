<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="ZVPGTZ_kurzusfelvetel">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="hallgato" type="hallgatoTipus"/>
                <xs:element name="kurzusok" type="kurzusokTipus"/>
            </xs:sequence>
            <xs:attribute name="tanev" type="xs:int" use="required"/>
            <xs:attribute name="egyetem" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="hallgatoTipus">
        <xs:sequence>
            <xs:element name="hnev" type="xs:string"/>
            <xs:element name="szulev" type="xs:int"/>
            <xs:element name="szak" type="szakTipus"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="szakTipus">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="evf" type="xs:int" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="kurzusokTipus">
        <xs:sequence>
            <xs:element name="kurzus"
                        type="kurzusTipus"
                        minOccurs="1"
                        maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="kurzusTipus">
        <xs:sequence>
            <xs:element name="kurzusnev" type="xs:string"/>
            <xs:element name="kredit" type="xs:int"/>
            <xs:element name="hely" type="xs:string"/>
            <xs:element name="idopont" type="xs:string"/>
            <xs:choice>
                <xs:element name="oktato" type="xs:string" minOccurs="0"/>
                <xs:element name="oraado" type="xs:string" minOccurs="0"/>
            </xs:choice>
        </xs:sequence>

        <xs:attribute name="id" type="idTipus" use="required"/>
        <xs:attribute name="jovahagyas" type="igenNemTipus" use="optional"/>
        <xs:attribute name="nyelv" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:simpleType name="igenNemTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="igen"/>
            <xs:enumeration value="nem"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="idTipus">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z0-9]{7,8}-[A-Z0-9]{2}-[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>